---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects | Archan Das" description="Projects by Archan Das.">
  <section class="prose">
    <p class="eyebrow">Projects</p>
    <h1>Projects</h1>
    <p class="lede">A running log of experiments, shipped work, prototypes, and useful tools.</p>
  </section>

  <section class="wrap section">
    <div class="grid">
      <article class="card">
        <h3>Project Name</h3>
        <p class="muted">Describe the problem, what you built, and what you learned.</p>
        <a href="#">Add a link</a>
      </article>
      <article class="card">
        <h3>Another Thing</h3>
        <p class="muted">Keep these short and scannable. You can add full case studies later.</p>
        <a href="#">Add a link</a>
      </article>
      <article class="card">
        <h3>Working Notes</h3>
        <p class="muted">Small tools and experiments are worth listing too.</p>
        <a href="/blog/">Related writing</a>
      </article>
    </div>
  </section>
</BaseLayout>
