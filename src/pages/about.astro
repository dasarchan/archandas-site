---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | Archandas" description="About Archandas.">
  <article class="prose">
    <p class="eyebrow">About</p>
    <h1>About Archandas</h1>
    <div class="about-intro">
      <img
        src="/archandas-profile.jpg"
        alt="Archandas standing in front of hills at sunset."
        width="1400"
        height="1400"
      />
      <div>
        <p>
          This is the place to write a compact introduction: who you are, what you work on,
          what you are curious about, and what kind of conversations you want this site to
          invite.
        </p>
        <p>
          Swap this page for something more specific when the shape of the site starts to
          feel real. A personal website gets better when it sounds like a person made it.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
